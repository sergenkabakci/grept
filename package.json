{
  "name": "grept",
  "version": "1.0.0",
  "description": "Windows-native GNU grep-compatible high-performance text search CLI",
  "type": "module",
  "bin": {
    "grept": "bin/grept.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "os": [
    "win32"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.{ts,js,json}\" \"tests/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\" \"tests/**/*.{ts,js,json}\"",
    "benchmark": "node ./dist/benchmarks/run.js"
  },
  "keywords": [
    "grep",
    "windows",
    "cli",
    "search",
    "regex",
    "pcre2",
    "gnu-grep",
    "text-search"
  ],
  "author": "grept contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergenkabakci/grept.git"
  },
  "bugs": {
    "url": "https://github.com/sergenkabakci/grept/issues"
  },
  "homepage": "https://github.com/sergenkabakci/grept#readme",
  "dependencies": {
    "pcre2-wasm": "^10.49.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.0.0"
  }
}
